
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Destination Explorer"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#172554"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore beautiful destinations"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:paddingBottom="12dp" />
    <TextView
        android:id="@+id/studentInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name: Sudeep J S | USN: 25MCAR0134"
        android:textSize="12sp"
        android:textColor="#475569"
        android:gravity="center"
        android:paddingBottom="8dp" />
    <ListView
        android:id="@+id/destinationList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CBD5E1"
        android:dividerHeight="1dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/detailPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:contentDescription="Selected destination image"
            android:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a destination"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#172554" />

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap an item above to view details."
                android:textSize="14sp"
                android:textColor="#64748B"
                android:paddingTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>