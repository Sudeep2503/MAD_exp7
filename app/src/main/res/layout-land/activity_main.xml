
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F7FA"
    android:padding="12dp">

    <!-- Left section: Destination list -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination Explorer"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center"
            android:padding="8dp" />

        <ListView
            android:id="@+id/destinationList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#CBD5E1"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- Right section: Destination details -->
    <LinearLayout
        android:id="@+id/detailPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="Selected destination image"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a destination"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap an item to view details."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>